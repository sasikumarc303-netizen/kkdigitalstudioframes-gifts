# Safe template only. Set private values in `.env` or your hosting provider's environment settings.
# =====================================================================
# KK Digital Studio – environment configuration
# Copy this file to `.env` (in the project root or in /server) and fill it in.
# NEVER commit your real .env file.
# =====================================================================

# ---- Core -----------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/kk-digital-studio
# Atlas (recommended for production): mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/kk-digital-studio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kk-digital-studio

# Long random string (32+ characters) used to sign admin sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_HOURS=8

# Public address of the website (used for sitemap.xml, canonical links and emails).
# Development: http://localhost:5000      Production: https://your-domain.com
SITE_URL=http://localhost:5000

# Only needed when the React app is served from a DIFFERENT origin than the API.
# In development with `npm run dev` set it to the Vite address so password-reset links point at the right place.
# Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# Production behind a proxy / HTTPS (Nginx, Render, Railway, Heroku…):
# COOKIE_SECURE=true marks the admin cookie as HTTPS-only, TRUST_PROXY=true reads the real client IP.
# Both default to true when NODE_ENV=production. Set COOKIE_SECURE=false ONLY if you serve over plain HTTP.
COOKIE_SECURE=
TRUST_PROXY=

# ---- First admin account (used by `npm run seed` / `npm run create-admin`) ----
# Password: at least 10 characters with a letter and a number. Change it after the first sign-in.
ADMIN_NAME=Studio Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Business contact details (OPTIONAL seed values) -------------------
# Nothing is invented: if you leave these empty the call / WhatsApp buttons stay hidden
# until you add the numbers in Admin → Contact info.
# WhatsApp number: digits with country code, e.g. 91XXXXXXXXXX
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_EMAIL=

# ---- WhatsApp order-status notifications (OPTIONAL) ----------------
# Automatic sends stay disabled unless all provider settings are valid.
# Store real values only in Render's backend environment, never in VITE_* variables.
# The approved utility template must contain three body parameters:
# order number, status, tracking URL (in that order).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Media storage ---------------------------------------------------
# When STORAGE_PROVIDER is blank, Cloudinary is selected if all three credentials are present.
# Otherwise local disk is used only in development; production requires an explicit persistent provider.
STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Select Backblaze explicitly to route new uploads to a private B2 bucket.
# Keep all B2 settings server-side; never add them to VITE_* variables.
B2_BUCKET_NAME=your-private-b2-bucket
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
# Watermark burned into generated public previews. Change this before uploading new media.
# FFmpeg and the bundled DejaVu Sans font render video watermarks; Sharp renders image watermarks.
MEDIA_WATERMARK_TEXT=© KK DIGITAL STUDIO
# Optional public backend origin for local and B2 preview delivery; Render's RENDER_EXTERNAL_URL is used by default.
MEDIA_BASE_URL=
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100

# ---- Email (optional) ------------------------------------------------
# Needed only to email admin password-reset links. Without SMTP the link is printed in the
# server console when NODE_ENV is not production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KK Digital Studio <no-reply@your-domain.com>"

# ---- Online payments -------------------------------------------------
# Online payment is disabled unless RAZORPAY_ENABLED=true. Keep it false until test-mode verification is complete.
PAYMENT_PROVIDER=none
RAZORPAY_ENABLED=false
RAZORPAY_TEST_MODE=true
RAZORPAY_ALLOW_TEST_MODE=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret