# LOCAL DEVELOPMENT FILE – contains a TEMPORARY admin password. Change it after first sign-in.
# =====================================================================
# KK Digital Studio – environment configuration
# Copy this file to `.env` (in the project root or in /server) and fill it in.
# NEVER commit your real .env file.
# =====================================================================

# ---- Core -----------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/kk-digital-studio
# Atlas (recommended for production): mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kk-digital-studio
MONGODB_URI=mongodb://127.0.0.1:27017/kk-digital-studio

# Long random string (32+ characters) used to sign admin sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=8871be7b11859896f134175cb7712bf5f8f1a9ee5a102b08480eb7fe7df9bd21f009c9ec86db6402ae6518719b55e077
JWT_EXPIRES_HOURS=8

# Public address of the website (used for sitemap.xml, canonical links and emails).
# Development: http://localhost:5000      Production: https://your-domain.com
SITE_URL=http://localhost:5000

# Only needed when the React app is served from a DIFFERENT origin than the API.
# In development with `npm run dev` set it to the Vite address so password-reset links point at the right place.
# Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# Production behind a proxy / HTTPS (Nginx, Render, Railway, Heroku…):
# COOKIE_SECURE=true marks the admin cookie as HTTPS-only, TRUST_PROXY=true reads the real client IP.
# Both default to true when NODE_ENV=production. Set COOKIE_SECURE=false ONLY if you serve over plain HTTP.
COOKIE_SECURE=
TRUST_PROXY=

# ---- First admin account (used by `npm run seed` / `npm run create-admin`) ----
# Password: at least 10 characters with a letter and a number. Change it after the first sign-in.
ADMIN_NAME=Studio Owner
ADMIN_EMAIL=srsasikumar987@gmail.com
ADMIN_PASSWORD=Sasi@12345

# ---- Business contact details (OPTIONAL seed values) -------------------
# Nothing is invented: if you leave these empty the call / WhatsApp buttons stay hidden
# until you add the numbers in Admin → Contact info.
# WhatsApp number: digits with country code, e.g. 91XXXXXXXXXX
BUSINESS_PHONE=6382694335
BUSINESS_WHATSAPP=916382694335
BUSINESS_EMAIL=srsasikumar987@gmail.com

# ---- Media storage ---------------------------------------------------
# Cloudinary is used automatically when all three values are present (recommended for production,
# because many hosts have temporary disks). Otherwise uploads are stored in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100

# ---- Email (optional) ------------------------------------------------
# Needed only to email admin password-reset links. Without SMTP the link is printed in the
# server console when NODE_ENV is not production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KK Digital Studio <no-reply@your-domain.com>"

# ---- Online payments -------------------------------------------------
# "none" = orders are enquiry-based; the studio confirms and arranges payment with the customer.
# A gateway (Razorpay, Stripe…) must be implemented in server/services/payments.js – see README.
PAYMENT_PROVIDER=none